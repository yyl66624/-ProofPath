# ProofPath 环境变量样例（只放变量名与取值方式，永不放假密钥）
#
# 用法：复制本文件为 .env 并填入真实值。.env 已被 .gitignore 忽略，不会入库。
# 绝对不要：把真实密钥写进本文件、issue、PR、群聊、截图或录屏。
# 完整规则见 docs/credentials.md。

# --- 模型：DeepSeek（见 docs/decisions.md D-012）----------------------------
# 必填。申请入口：https://platform.deepseek.com/ → API Keys
DEEPSEEK_API_KEY=

# 可选。默认 https://api.deepseek.com（OpenAI 兼容格式）
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 可选。默认 deepseek-flash；难例可改 deepseek-v4-pro
DEEPSEEK_MODEL=deepseek-flash

# --- 后端服务（P06 落地后生效，变量名为拟定契约，变更走 D-xxx）---------------
PROOFPATH_HOST=127.0.0.1
PROOFPATH_PORT=8000
# 上传文件大小上限（字节），默认 20 MiB
PROOFPATH_MAX_UPLOAD_BYTES=20971520
# 单次分析超时（秒）
PROOFPATH_ANALYZE_TIMEOUT_SECONDS=120

# --- 过渡期专用（P06 合并后删除）--------------------------------------------
# 当前 check 命令仍走 Anthropic，切换完成后本项连同依赖一起移除
ANTHROPIC_API_KEY=
